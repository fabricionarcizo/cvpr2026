--- vendor/device/qcom/lahaina/system.prop	2026-05-22 07:52:13.329879592 +0200
+++ vendor/device/qcom/lahaina/system.prop	2026-05-22 14:10:29.025860607 +0200
@@ -194,3 +194,35 @@
 
 #Expose aux camera for below packages
 vendor.camera.aux.packagelist=org.codeaurora.snapcam
+
+#
+# Enable Wi-Fi + ADB
+#
+persist.vendor.usb.config=adb
+persist.sys.usb.config=adb
+service.adb.tcp.port=5555
+persist.service.adb.enable=1
+persist.service.debuggable=1
+ro.adb.secure=0
+ro.secure=0
+ro.debuggable=1
+sys.usb.configfs=1
+wifi.interface=wlan0
+
+#
+# USB Controller
+#
+vendor.usb.controller=a600000.dwc3
+sys.usb.controller=a600000.dwc3
+
+#
+# Disable lockscreen
+#
+lockscreen.disabled=true
+ro.lockscreen.disable.default=true
+
+#
+# Screen timeout
+#
+persist.sys.screen_off_timeout=1800000
+
